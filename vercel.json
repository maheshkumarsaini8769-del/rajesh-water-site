{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/(orders\\.html|admin\\.html|robots\\.txt|sitemap\\.xml)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(css|js|images|data)/(.*)",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "/admin",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/orders",
      "dest": "/frontend/orders.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
